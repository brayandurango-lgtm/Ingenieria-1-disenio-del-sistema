{
  "info": {
    "name": "Autos Colombia - API REST",
    "description": "Colección de Postman para probar la API del sistema de parqueadero Autos Colombia - Iteración 1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
